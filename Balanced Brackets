def is_balanced(s):
    stack = []
    bracket_map = {')': '(', '}': '{', ']': '['}
    
    for char in s:
        if char in bracket_map.values():  # Check if it's an opening bracket
            stack.append(char)
        elif char in bracket_map:  # Check if it's a closing bracket
            if not stack or stack.pop() != bracket_map[char]:
                return "NO"
    
    return "YES" if not stack else "NO"

print(is_balanced("{[()]}"))
print(is_balanced("{[(])}"))
print(is_balanced("{{[[(())]]}}"))
